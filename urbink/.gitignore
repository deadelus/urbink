# Config locaux — contiennent des clés, ne jamais committer
config/*.json
!config/*.json.example

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase options — contiennent des clés API, ne jamais committer
# En local : généré par flutterfire configure | En CI : écrit depuis le secret GitHub
lib/firebase_options.dart

# Fichiers Firebase natifs — clés API, ne jamais committer
# En local : télécharger depuis Firebase Console → ios/Runner/GoogleService-Info.plist
# En CI : écrit depuis le secret GitHub GOOGLE_SERVICE_INFO de l'environment correspondant
ios/Runner/GoogleService-Info.plist
android/app/google-services.json
