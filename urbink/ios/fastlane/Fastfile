default_platform(:ios)

platform :ios do
  # Lane beta : build + upload TestFlight
  # Déclenchée par un tag vX.Y.Z via GitHub Actions deploy.yml
  desc "Build Flutter IPA et soumettre à TestFlight"
  lane :beta do
    # Récupération du numéro de build depuis le tag Git (ex: v1.2.3 → build 123)
    build_number = ENV["FLUTTER_BUILD_TAG"]&.gsub(/[^0-9]/, '') || "1"

    # Certificates & profiles via match (cert store Git privé)
    # MATCH_GIT_URL et MATCH_PASSWORD lus depuis les secrets GitHub
    match(
      type: "appstore",
      readonly: true,
    )

    # Build Flutter IPA (prod)
    sh(
      "cd ../.. && flutter build ipa " \
      "--dart-define=FLUTTER_ENV=prod " \
      "--build-number=#{build_number} " \
      "--export-options-plist=ios/ExportOptions.plist"
    )

    # Upload TestFlight via App Store Connect API
    upload_to_testflight(
      ipa: "../../build/ios/ipa/urbink.ipa",
      api_key_path: nil, # clé inline ci-dessous
      api_key: {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT"],
        is_key_content_base64: true,
      },
      skip_waiting_for_build_processing: true,
    )
  end
end
