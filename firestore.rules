rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Toutes les données utilisateur — sessions, streets, badges
    // Accès strictement limité au propriétaire authentifié (RGPD, NFR13)
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Données quartiers — lecture publique (secretLocal révélé côté client après badge)
    // Écriture réservée aux Cloud Functions via Admin SDK (pas de règle client)
    match /quartiers/{quartierId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
